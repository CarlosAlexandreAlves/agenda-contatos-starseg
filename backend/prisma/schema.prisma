datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contato {
  id          Int      @id @default(autoincrement())
  nome        String
  telefone    String
  email       String
  cep         String
  estado      String
  cidade      String
  bairro      String
  rua         String
  numero      String
  complemento String?
  foto        String?     
  createdAt   DateTime @default(now())
}

model User {
  id       Int     @id @default(autoincrement())
  nome     String
  email    String  @unique
  senha    String
  createdAt DateTime @default(now())
}